NODE_ENV=dev

PORT=4000

### Database - Postgres
# These values are for running the API on your machine (npm run dev, IDE debugger):
# the database container publishes PostgreSQL on localhost:8432.
# Inside Docker (npm run docker:dev) docker-compose.dev.yml overrides them with db_postgres:5432.
PG_HOST=localhost
PG_PORT=8432
POSTGRES_USER=walter
POSTGRES_PASSWORD=white
POSTGRES_DB=boilerplate

